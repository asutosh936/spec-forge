# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# Compiled class files
*.class

# Log files
*.log
logs/

# Package files (keep Maven wrapper jar, exclude everything else)
*.jar
*.war
*.ear

# Secrets and local config — never commit these
.env
.env.local
application-local.yml
application-local.yaml

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# JVM crash logs
hs_err_pid*
replay_pid*
